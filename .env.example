# Copie com `npm run setup` (gera os segredos). Usado pelo Docker e pelo desenvolvimento local.

# ── Banco de dados ──
POSTGRES_PASSWORD=
# usado só fora do Docker (o compose monta a própria URL)
DATABASE_URL=
POSTGRES_PORT=5434

# ── Comunicação interna entre o site e a API (obrigatório, 32+ caracteres) ──
INTERNAL_API_KEY=
API_URL=http://localhost:3333
API_PORT=3333

# ── Site ──
WEB_PORT=3000
# endereço público do site, usado no link de recuperação de senha
APP_URL=http://localhost:3000

# ── Formulários e e-mail ──
CAPTCHA_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site HR da Amazônia <no-reply@hr.log.br>"
MAIL_TO_CONTATO=comercial@hr.log.br
MAIL_TO_COTACAO=comercial@hr.log.br
