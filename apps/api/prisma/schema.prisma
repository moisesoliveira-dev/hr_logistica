generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  marketing
  operacao
  colaborador
}

enum PostStatus {
  rascunho
  publicado
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(100)
  // sempre gravado em minúsculas
  email              String    @unique @db.VarChar(200)
  department         String    @db.VarChar(60)
  role               Role      @default(colaborador)
  passwordHash       String    @map("password_hash")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tempExpiresAt      DateTime? @map("temp_expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  sessions    Session[]
  resetTokens ResetToken[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     Int      @map("user_id")
  remember   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String   @db.VarChar(60)
  userAgent  String   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ResetToken {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reset_tokens")
}

model Throttle {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@map("throttle")
}

// captchas já usados (cada um vale uma tentativa)
model UsedCaptcha {
  nonce     String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("used_captchas")
}

model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now()) @db.Timestamptz(3)
  actor  String
  event  String
  detail String   @default("")
  ip     String   @default("")

  @@index([actor])
  @@index([event, at])
  @@map("audit_logs")
}

// Imagens enviadas pelo marketing. Guardadas no próprio banco (entra no backup do PostgreSQL).
model Media {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String   @db.VarChar(200)
  mimeType   String   @map("mime_type") @db.VarChar(50)
  size       Int
  width      Int?
  height     Int?
  alt        String   @default("") @db.VarChar(300)
  data       Bytes
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts     Post[]
  siteItems SiteItem[]

  @@map("media")
}

// Notícias do HR NEWS
model Post {
  id          Int        @id @default(autoincrement())
  slug        String     @unique @db.VarChar(160)
  title       String     @db.VarChar(200)
  excerpt     String     @db.VarChar(400)
  body        String
  coverId     String?    @map("cover_id") @db.Uuid
  status      PostStatus @default(rascunho)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  createdBy   String     @map("created_by")
  updatedBy   String     @map("updated_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  cover Media? @relation(fields: [coverId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("posts")
}

enum SiteSection {
  destaques
  depoimentos
  clientes
  galeria_frota
  galeria_armazens
  galeria_estrutura
}

// Itens das partes do site que o marketing monta: fotos do topo, depoimentos, clientes e galerias
model SiteItem {
  id        Int         @id @default(autoincrement())
  section   SiteSection
  title     String      @default("") @db.VarChar(200)
  subtitle  String      @default("") @db.VarChar(200)
  text      String      @default("")
  mediaId   String?     @map("media_id") @db.Uuid
  // foto que já vinha no site (pasta public); some quando o marketing envia outra
  staticSrc String?     @map("static_src") @db.VarChar(200)
  position  Int
  visible   Boolean     @default(true)
  updatedBy String      @map("updated_by")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // uma imagem em uso não pode ser apagada
  media Media? @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([section, position])
  @@map("site_items")
}

// Contatos, redes sociais e unidades mostrados no site. Uma única linha (id 1).
model SiteSettings {
  id        Int      @id
  data      Json
  updatedBy String   @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

enum CargoStage {
  aguardando_coleta
  coletada
  no_terminal
  em_transito
  centro_distribuicao
  saiu_entrega
  entregue
  ocorrencia
}

enum CargoMode {
  rodoviario
  rodo_fluvial
  cabotagem
  multimodal
}

// Cargas acompanhadas pelo cliente no site
model Shipment {
  id               Int        @id @default(autoincrement())
  code             String     @unique @db.VarChar(12)
  invoice          String     @default("") @db.VarChar(60)
  customerName     String     @map("customer_name") @db.VarChar(150)
  // CPF ou CNPJ sem pontuação
  customerDocument String     @map("customer_document") @db.VarChar(14)
  origin           String     @db.VarChar(120)
  destination      String     @db.VarChar(120)
  mode             CargoMode
  expectedAt       DateTime?  @map("expected_at") @db.Date
  // cópia da etapa do evento mais recente, para a lista e o filtro
  stage            CargoStage
  createdBy        String     @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events ShipmentEvent[]

  @@index([stage, updatedAt])
  @@index([customerDocument])
  @@map("shipments")
}

model ShipmentEvent {
  id         Int        @id @default(autoincrement())
  shipmentId Int        @map("shipment_id")
  stage      CargoStage
  location   String     @db.VarChar(120)
  note       String     @default("") @db.VarChar(500)
  at         DateTime   @db.Timestamptz(3)
  createdBy  String     @map("created_by")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, at])
  @@map("shipment_events")
}
